{
  "name": "viziers-vault",
  "version": "0.0.0",
  "private": true,
  "description": "Vizier's Vault — marketing site + app monorepo",
  "author": "viziers-vault-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mjf1406/viziers-vault-app.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:web": "vp --filter @vv/web dev",
    "build:web": "bun run --filter @vv/web build",
    "build": "vp run -r build",
    "check": "vp check --fix && bun run lint:fix && bun run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "audit": "bun audit",
    "preview": "vp preview",
    "post-clone": "bun apps/app/scripts/post-clone.mjs",
    "prepare": "vp config",
    "tp": "bun apps/app/scripts/tag-push.mjs",
    "electron:download-backend": "bun --cwd apps/app scripts/download-convex-backend.mjs",
    "electron:build-main": "bun --cwd apps/app scripts/build-electron.mjs",
    "electron:dev": "bun --cwd apps/app scripts/electron-dev.mjs",
    "electron:pack": "bun --cwd apps/app scripts/electron-pack.mjs --dir",
    "electron:dist": "bun --cwd apps/app scripts/electron-pack.mjs"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "patchedDependencies": {
    "@convex-dev/polar@0.9.2": "patches/@convex-dev%2Fpolar@0.9.2.patch"
  }
}
